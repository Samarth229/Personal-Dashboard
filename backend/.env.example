# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
BACKEND_URL=                          # e.g. https://your-app.onrender.com  (leave blank in dev)
FRONTEND_URL=http://localhost:5173

# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite — path to the .db file (defaults to backend/data/dashboard.db)
DATABASE_PATH=                        # optional override

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ─── Email (Brevo SMTP) ────────────────────────────────────────────────────────
# Sign up free at https://app.brevo.com — 300 emails/day
BREVO_SMTP_USER=your_brevo_login_email
BREVO_SMTP_PASS=your_brevo_smtp_key

# ─── Google OAuth (login + Gmail) ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/gmail/callback

# ─── Spotify OAuth ─────────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:5000/api/spotify/callback

# ─── GitHub OAuth ──────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:5000/api/github/callback

# ─── Steam ─────────────────────────────────────────────────────────────────────
# Get key at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key

# ─── Riot Games ────────────────────────────────────────────────────────────────
# Personal API key from https://developer.riotgames.com
RIOT_API_KEY=your_riot_api_key
RIOT_REGION=na1
